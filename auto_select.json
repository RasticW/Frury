{
  "remarks": "🌐 Авто-Выбор",
  "dns": {
    "tag": "dns-inbound",
    "servers": [
      "https://8.8.8.8/dns-query",
      "https://8.8.4.4/dns-query",
      "https://1.1.1.1/dns-query",
      "https://1.0.0.1/dns-query"
    ],
    "queryStrategy": "UseIPv4"
  },
  "log": {
    "loglevel": "warning"
  },
  "stats": {},
  "policy": {
    "levels": {
      "8": {
        "connIdle": 600,
        "handshake": 4,
        "uplinkOnly": 1,
        "downlinkOnly": 1
      }
    },
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "routing": {
    "rules": [
      {
        "port": 53,
        "type": "field",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "domain": [
          "geosite:torrent"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:google-play",
          "geosite:github",
          "geosite:twitch-ads",
          "geosite:youtube",
          "geosite:telegram"
        ],
        "balancerTag": "auto-balancer"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private",
          "geosite:category-ru",
          "geosite:whitelist",
          "geosite:microsoft",
          "geosite:apple",
          "geosite:epicgames",
          "geosite:riot",
          "geosite:escapefromtarkov",
          "geosite:steam",
          "geosite:twitch",
          "geosite:pinterest",
          "geosite:faceit"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      },
      {
        "ip": [
          "geoip:private",
          "geoip:direct"
        ],
        "type": "field",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "ozon.ru",
          "ozon.com"
        ],
        "balancerTag": "auto-balancer"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "auto-balancer"
      }
    ],
    "balancers": [
      {
        "tag": "auto-balancer",
        "selector": [
          "auto-0-nl-proxy-1",
          "auto-0-nl-proxy-2",
          "auto-0-nl-proxy-3",
          "auto-0-nl-proxy-4",
          "auto-0-nl-proxy-5",
          "auto-0-nl-proxy-6",
          "auto-0-nl-proxy-7",
          "auto-0-nl-proxy-8",
          "auto-0-nl-proxy-9",
          "auto-0-nl-proxy-10",
          "auto-0-nl-proxy-11",
          "auto-0-nl-proxy-12",
          "auto-0-nl-proxy-13",
          "auto-0-nl-proxy-14",
          "auto-0-nl-proxy-15",
          "auto-0-nl-proxy-16",
          "auto-0-nl-proxy-17",
          "auto-0-nl-proxy-18",
          "auto-0-nl-proxy-19",
          "auto-0-nl-proxy-20",
          "auto-1-proxy",
          "auto-1-proxy-2",
          "auto-1-proxy-3",
          "auto-1-proxy-4",
          "auto-1-proxy-5",
          "auto-1-proxy-6",
          "auto-2-node-2-",
          "auto-2-node-2--2",
          "auto-2-node-2--3",
          "auto-2-node-2--4",
          "auto-2-node-2--5",
          "auto-3-node-2-"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "maxRTT": "5s",
            "expected": 2,
            "baselines": [
              "200ms",
              "500ms",
              "1000ms"
            ],
            "tolerance": 0.5
          }
        },
        "fallbackTag": "direct"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch"
  },
  "inbounds": [
    {
      "tag": "socks",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth",
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http",
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "userLevel": 8,
        "allowTransparent": false
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
